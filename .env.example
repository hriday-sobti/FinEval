# FinEval Environment Configuration
# Copy this file to .env and adjust variables as needed.

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Relational Database URL
# By default, uses local SQLite database for effortless local development.
# For Docker PostgreSQL, use: postgresql+psycopg://fineval_user:fineval_password@localhost:5432/fineval_db
DATABASE_URL=sqlite:///./data/fineval.db

# LLM Provider Configuration
# Set LLM_PROVIDER to 'mock' for fully deterministic benchmark runs without API keys.
# Set LLM_PROVIDER to 'live' for real model API calls.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3

# Evaluator LLM Configuration (LLM-as-Judge Layer 4)
JUDGE_PROVIDER=mock
JUDGE_MODEL=gpt-4o-mini
JUDGE_TEMPERATURE=0.0
JUDGE_TIMEOUT_SECONDS=30
